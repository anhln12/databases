grep -vE '^\s*(#|$)' 

# Backup toàn bộ cluster 13
pg_dumpall -U postgres > /var/backups/postgres13_full.sql

systemctl stop postgresql@13-main


apt install postgresql-16 -y

1. Chuẩn bị thư mục mới cho PostgreSQL 16

mkdir -p /data/postgresql/16/{main,archive,logs,wal_archive}
chown -R postgres:postgres /data/postgresql/16
chmod 700 /data/postgresql/16/main

2. Init cluster 16

pg_createcluster 16 main --datadir=/data/postgresql/16/main


3. Stop dịch vụ PostgreSQL 13

systemctl stop postgresql@13-main


root@db-mysql-05:/etc/postgresql/13/main# sudo -u postgres /usr/lib/postgresql/16/bin/pg_upgrade \
  -b /usr/lib/postgresql/13/bin \
  -B /usr/lib/postgresql/16/bin \
  -d /data/postgresql/13/main \
  -D /data/postgresql/16/main \
  -U postgres \
  --socketdir=/tmp \
  -o "-c config_file=/etc/postgresql/13/main/postgresql.conf"
